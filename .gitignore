# Repo-wide safety net. Each stack also has its own .gitignore; this covers any folder added later.

# Terraform working dirs, plans and logs
.terraform/
tfplan
*.tfplan
crash.log
crash.*.log

# Variable files hold secrets (jwt_secret, IPs, IDs). Only *.example files are committed.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Backend config is generated per account (cluster/backend.hcl.example is the template)
backend.hcl

# State files. Exception: bootstrap/terraform.tfstate is committed ON PURPOSE (it's the only record of the
# state bucket itself). Every other stack keeps state in S3.
*.tfstate
*.tfstate.*
!bootstrap/terraform.tfstate

# Build output (authorizer zip is rebuilt by `make zip`)
build/
*.zip

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Local secrets / editor junk
.env
.env.*
*.pem
*.key
.DS_Store

# Local command logs (terraform plan/apply output)
*.log
